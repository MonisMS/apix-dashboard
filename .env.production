# The deployed dashboard reads the live API in this same deployment:
# app/api/v1/* route handlers backed by Neon Postgres. One origin, one host,
# no CORS, nothing to wake.
#
# The snapshot in public/data/v1 remains as an emergency fallback: set
# NEXT_PUBLIC_API_STATIC=1 and redeploy to serve it instead of the database.
# It is regenerated from the live API at build time, so it cannot disagree
# with it.
NEXT_PUBLIC_API_STATIC=0
NEXT_PUBLIC_API_BASE=/api/v1
