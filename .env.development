# Dev reads the live API in this same app: app/api/v1/* route handlers backed
# by Neon. Same origin, so no proxy and no CORS.
#
# Set NEXT_PUBLIC_API_STATIC=1 to fall back to the snapshot in
# public/data/v1 -- useful offline, or if the database is unreachable.
NEXT_PUBLIC_API_STATIC=0
NEXT_PUBLIC_API_BASE=/api/v1

# The public origin the API page copies into clipboard URLs. Set to the live
# host even in development: a copied endpoint is meant to be handed to someone
# else, and http://localhost:3000/api/v1/index is useless to them. The links
# themselves stay relative, so clicking still opens whatever you are running.
NEXT_PUBLIC_APIX_SITE_URL=https://apix-dashboard-gitbashers.vercel.app
